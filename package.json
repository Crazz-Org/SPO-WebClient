{
  "name": "starpeace-online-client",
  "version": "0.0.0-dev",
  "description": "TypeScript web client for Starpeace Online - A browser-based multiplayer tycoon/simulation game",
  "main": "dist/server/server.js",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.e2e.json && tsc --noEmit -p tsconfig.tests.json",
    "build:server": "tsc",
    "build:client": "vite build",
    "build:terrain-test": "esbuild src/client/terrain-test.ts --bundle --outfile=public/terrain-test.js --format=iife",
    "build": "npm run build:server && npm run build:client && npm run build:terrain-test",
    "start": "node --disable-warning=DEP0040 dist/server/server.js",
    "start:cache-sync": "node --disable-warning=DEP0040 dist/server/cache-sync-service.js",
    "dev": "bash scripts/bench-submit.sh --type=lease --wait",
    "dev:release": "bash scripts/bench-release.sh",
    "dev:local": "bash scripts/dev-local.sh",
    "dev:react": "vite",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose",
    "test:changed": "jest --onlyChanged --bail",
    "test:smoke": "jest --selectProjects component --bail",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:preview": "node scripts/changelog.js --preview",
    "build:e2e": "tsc -p tsconfig.e2e.json",
    "test:live": "bash scripts/bench-submit.sh --type=live --wait",
    "test:live:local": "npm run build:e2e && node dist/e2e/run.js",
    "gate": "bash scripts/bench-gate.sh",
    "gate:precheck": "npm run typecheck && npm run lint && npm run coverage:changed",
    "coverage:changed": "node scripts/coverage-changed.js",
    "gate:local": "node scripts/verify-gate.js",
    "finish": "bash scripts/finish.sh",
    "deps:gate": "bash scripts/deps-gate.sh",
    "bench:status": "bash scripts/bench-status.sh",
    "bench:wait": "bash scripts/bench-wait.sh",
    "pr:wait": "bash scripts/pr-wait.sh",
    "bench:nightly": "bash scripts/nightly-check.sh",
    "board:status": "bash scripts/board-status.sh",
    "board:take": "bash scripts/board-take.sh",
    "board:move": "bash scripts/board-move.sh",
    "board:block": "bash scripts/board-block.sh",
    "board:claim": "bash scripts/claim-read.sh",
    "board:verify": "bash scripts/claim-verify.sh",
    "board:wait": "bash scripts/rate-wait.sh",
    "report:card": "node scripts/report-card.js",
    "e2e:unlock": "npm run build:e2e && node dist/e2e/unlock.js",
    "verdict": "bash scripts/run-verdict.sh"
  },
  "keywords": [
    "starpeace",
    "online",
    "game",
    "multiplayer",
    "tycoon",
    "simulation",
    "websocket",
    "typescript"
  ],
  "author": "Crazz-E",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Crazz-Org/SPO-WebClient.git"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "7zip-min": "^3.0.1",
    "cheerio": "^1.1.2",
    "gifuct-js": "^2.1.2",
    "lucide-react": "^1.35.0",
    "node-fetch": "^2.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.8",
    "ws": "^8.19.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22",
    "@types/node-fetch": "^2.6.12",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.1"
  }
}
